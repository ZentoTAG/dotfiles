{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/home/zento/.config/fastfetch/ascii/ohayou.txt",
        "height": 20,
        "color": {
            "1": "white"
        }
    },
  "display": {
    "separator": " ➜  "
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "#d4878a"
    },
    {
      "type": "kernel",
      "key": " ├  ",
      "keyColor": "#d4878a"
    },
    {
      "type": "shell",
      "key": " └  ",
      "keyColor": "#d4878a"
    },
    "break",
    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "#a8c88a"
    },
    {
      "type": "terminal",
      "key": " ├  ",
      "keyColor": "#a8c88a"
    },
    {
      "type": "terminalfont",
      "key": " └  ",
      "keyColor": "#a8c88a"
    },
    "break",
    {
      "type": "host",
      "format": "{5} {1} Type {2}",
      "key": "PC   ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7} GHz",
      "key": " ├  ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "gpu",
      "format": "{1} {2} @ {12} GHz",
      "key": " ├ 󰢮 ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "memory",
      "key": " ├  ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "swap",
      "key": " ├ 󰓡 ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "disk",
      "key": " ├ 󰋊 ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "monitor",
      "key": " └  ",
      "keyColor": "#d9b86b"
    },
    "break",
    "break"
  ]
}
