{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/zento/.config/fastfetch/ascii/active.txt",
    "position": "left",
    "padding": {
      "left": 1,
      "right": 2,
      "bottom": 1
    },
    "color": {
      "1": "#ffb663",
      "2": "#e5be63"
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "#ffb68d",
      "title": "#e5beaa"
    },
    "percent": {
      "color": {
        "green": "#cdc991",
        "yellow": "#ffb68d",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "#d4878a"
    },
    {
      "type": "kernel",
      "key": " ├  ",
      "keyColor": "#d4878a"
    },
    {
      "type": "shell",
      "key": " └  ",
      "keyColor": "#d4878a"
    },
    "break",
    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "#a8c88a"
    },
    {
      "type": "terminal",
      "key": " ├  ",
      "keyColor": "#a8c88a"
    },
    {
      "type": "terminalfont",
      "key": " └  ",
      "keyColor": "#a8c88a"
    },
    "break",
    {
      "type": "host",
      "format": "{5} {1} Type {2}",
      "key": "PC   ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7}",
      "key": " ├  ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": " ├ 󰢮 ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "memory",
      "key": " ├  ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "swap",
      "key": " ├ 󰓡 ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "disk",
      "key": " ├ 󰋊 ",
      "keyColor": "#d9b86b"
    },
    {
      "type": "display",
      "format": "{1}x{2} @ {3} Hz",
      "key": " └  ",
      "keyColor": "#d9b86b"
    },
    "break",
    "break"
  ]
}
