{
    "layer": "top",
    "modules-left": ["custom/launcher", "hyprland/workspaces", "group/media"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "custom/swaync", "hyprland/submap", "group/volume",  "custom/temperature", "cpu", "memory", "custom/brightness"],

    "hyprland/window": {
        "max-length": 50
    },

    "custom/launcher": {
        "format": "",
        "on-click": "hyprlock",
        "tooltip": false
    },

    "custom/temperature": {
        "exec": "sensors | grep 'Package id 0' | awk '{print $4}' | cut -c2- | cut -d'.' -f1",
        "interval": 5,
        "format": " {}°C",
        "on-click": "kitty --title btop -e btop"
    },

    "custom/brightness": {
        "exec": "brightnessctl | grep 'Current' | awk '{print $4}' | tr -d '()%'",
        "interval": 5,
        "format": " {}%",
        "on-click": "brightnessctl s 10%+",
        "on-click-right": "brightnessctl s 10%-"
    },

    "cpu": {
        "interval": 10,
        "format": "{usage}% ",
        "format-alt": "{avg}% ",
        "max-length": 10,
        "on-click": "exec kitty --title btop -e btop"
    },

    "memory": {
        "interval": 10,
        "format": " {percentage}%",
        "tooltip-format": "{used:0.1f}G/{total:0.1f}G used",
        "on-click": "exec kitty --title htop -e htop"
    },

    "clock": {
        "format": "{:%a, %d.%m.%Y %H:%M}",
        "locale": "ru_RU.UTF-8",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "format": {
                "today": "<span color='#b0b0b0'><b>{}</b></span>"
            }
        },
        "on-click": "exec firefox --new-window https://calendar.google.com"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", ""]
        },
        "scroll-step": 1,
        "ignored-sinks": ["Easy Effects Sink"],
        "on-click": "pavucontrol"
    },

    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },

    "group/volume": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },

    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "custom/media-animation",
            "custom/media-now-playing"
        ]
    },

    "custom/media-now-playing": {
        "exec": "/home/zento/.config/waybar/custom_modules/media/media-now-playing.sh",
        "escape": true,
        "tooltip": false,
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl previous",
        "on-click-right": "playerctl next"
    },

    "custom/media-animation": {
        "exec": "/home/zento/.config/waybar/custom_modules/media/media-animation.sh",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "show-passive": false,
        "show-hidden": false
    },

    "custom/swaync": {
        "format": " {count}",
        "on-click": "swaync-client -t",
        "exec": "swaync-client -c",
        "interval": 1,
        "tooltip": false
    }
}
